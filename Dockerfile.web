FROM node:22.23.4-alpine@sha256:fe4f6d74e20370acb04ad889077d14d0f64a9c8ea6a42bc60cddf1e844699914 AS deps
WORKDIR /app
COPY container/patch-npm.mjs /tmp/patch-npm.mjs
RUN npm install --global npm@12.2.1 --ignore-scripts && node /tmp/patch-npm.mjs && rm /tmp/patch-npm.mjs
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts

FROM nginx:1.31.8-alpine@sha256:a3554c0d0b48177b1413c26e01f695334428020d9df01243fbae3e11cfd17417
COPY --from=deps /app/node_modules /usr/share/nginx/html/node_modules
COPY . /usr/share/nginx/html/
RUN sed -i 's/listen\s*80;/listen 7011;/g' /etc/nginx/conf.d/default.conf
EXPOSE 7011
CMD ["nginx", "-g", "daemon off;"]
