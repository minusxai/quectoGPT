FROM node:22.23.4-alpine@sha256:fe4f6d74e20370acb04ad889077d14d0f64a9c8ea6a42bc60cddf1e844699914 AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev

FROM nginx:alpine
COPY --from=deps /app/node_modules /usr/share/nginx/html/node_modules
COPY . /usr/share/nginx/html/
RUN sed -i 's/listen\s*80;/listen 7011;/g' /etc/nginx/conf.d/default.conf
EXPOSE 7011
CMD ["nginx", "-g", "daemon off;"]
